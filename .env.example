# Copia este archivo a .env y completa los valores. Nunca versiones .env.

# ── PostgreSQL (Neon) ─────────────────────────────────────────
DB_URL=jdbc:postgresql://<HOST>/<DATABASE>?sslmode=require&channel_binding=require
DB_USERNAME=<USERNAME>
DB_PASSWORD=<PASSWORD>

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=<SECRET>
JWT_EXPIRATION=3600

# ── CORS ──────────────────────────────────────────────────────
# Orígenes del frontend autorizados a llamar al API (separados por coma).
CORS_ALLOWED_ORIGINS=http://localhost:4200

# ── Usuario administrador inicial ─────────────────────────────
# Se crea al arrancar si no existe. Debe coincidir con lo que espera el frontend.
ADMIN_EMAIL=admin@adventureretail.com
ADMIN_PASSWORD=Admin2025!
