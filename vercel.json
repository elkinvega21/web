{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "buildCommand": "npm --prefix apps/frontend install && npm --prefix apps/frontend run build",
  "outputDirectory": "apps/frontend/dist/adventure-frontend/browser",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
